# Copia este archivo a .env y completa los valores. Nunca commitees .env real.

DJANGO_SECRET_KEY=change-me-generate-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Nunca en el repo, nunca en un secret manager compartido con otros servicios (Documento 04 Parte A.1).
FERNET_KEY=

DATABASE_URL=postgres://datadictai:datadictai@db:5432/datadictai
REDIS_URL=redis://redis:6379/0

# True solo en dev/CI (docker-compose vive en red privada). Nunca True en produccion.
ALLOW_PRIVATE_DB_HOSTS=True

POSTGRES_DB=datadictai
POSTGRES_USER=datadictai
POSTGRES_PASSWORD=datadictai

# OpenAI API key. Sin ella, ai_engine cae al fallback "no hay contexto suficiente"
# en vez de fallar (Documento 02 SS6).
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Billing (LemonSqueezy, no Stripe -- Colombia no esta soportada para crear
# cuenta vendedora en Stripe). Genera la API key en tu tienda -> Ajustes -> API.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Elegido por ti al crear el webhook en Ajustes -> Webhooks.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
