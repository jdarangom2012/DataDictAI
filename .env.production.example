# Plantilla para el .env real de produccion, que vive UNICAMENTE en la VM
# (nunca en el repo, nunca en Git). Copiar a .env en la VM y completar.

# Genera uno nuevo y distinto al de desarrollo:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DEBUG=False

# IP publica de la VM (y el dominio, en cuanto se agregue uno). Sin espacios.
ALLOWED_HOSTS=52.165.89.25
# Vacio mientras no haya dominio con HTTPS -- Caddy sirve en HTTP plano por ahora.
CSRF_TRUSTED_ORIGINS=

# Nunca reutilizar la key de FERNET de desarrollo: cada entorno tiene la suya.
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

DATABASE_URL=postgres://datadictai:datadictai@db:5432/datadictai
REDIS_URL=redis://redis:6379/0

# Genera una contraseña fuerte, distinta a la de desarrollo local:
POSTGRES_DB=datadictai
POSTGRES_USER=datadictai
POSTGRES_PASSWORD=

# Falso en produccion siempre: el host de la BD del cliente nunca debe ser
# una IP privada/loopback en un entorno real (Documento 04 Parte A.2).
ALLOW_PRIVATE_DB_HOSTS=False

# Se mantienen en False hasta que Caddy tenga un dominio real + TLS (Let's
# Encrypt). Ver el comentario en config/settings.py y en el Caddyfile.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Billing (LemonSqueezy) -- usar las MISMAS claves que ya tienes en tu .env
# local (son de la misma tienda), salvo el webhook: crea un webhook nuevo en
# LemonSqueezy apuntando a http://<IP-o-dominio>/api/v1/billing/webhook/ y usa
# ese secreto nuevo aqui, no el de ngrok.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_TEAM=
